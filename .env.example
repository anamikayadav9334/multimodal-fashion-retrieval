# Optional: LLM query parser via OpenRouter free models (https://openrouter.ai/keys, no card needed).
# Copy this file to .env and put your key there - NEVER put a real key in .env.example (it is committed).
# If unset or rate-limited, the retriever falls back to the rule-based parser automatically.
OPENROUTER_API_KEY=

# Kaggle auth is read from ~/.kaggle/access_token (or ~/.kaggle/kaggle.json) — nothing needed here.
